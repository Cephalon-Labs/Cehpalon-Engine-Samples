<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><IsPackable>false</IsPackable><Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
    <EngineRoot Condition="'$(EngineRoot)' == ''">../../Cehpalon-Engine</EngineRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);evidence/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="[11.0.0]" />
    <ProjectReference Include="$(EngineRoot)/src/Cehpalon.Engine.Authorization/Cehpalon.Engine.Authorization.csproj" />
    <ProjectReference Include="$(EngineRoot)/src/Cehpalon.Engine.Identity.AspNetCore/Cehpalon.Engine.Identity.AspNetCore.csproj" />
    <ProjectReference Include="$(EngineRoot)/src/Cehpalon.Engine.Identity.JwtBearer/Cehpalon.Engine.Identity.JwtBearer.csproj" />
    <ProjectReference Include="$(EngineRoot)/src/Cehpalon.Engine.Composition/Cehpalon.Engine.Composition.csproj" />
    <ProjectReference Include="$(EngineRoot)/src/Cehpalon.Engine.Transports.GraphQL/Cehpalon.Engine.Transports.GraphQL.csproj" />
    <ProjectReference Include="$(EngineRoot)/src/Cehpalon.Engine.CodeGeneration/Cehpalon.Engine.CodeGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
