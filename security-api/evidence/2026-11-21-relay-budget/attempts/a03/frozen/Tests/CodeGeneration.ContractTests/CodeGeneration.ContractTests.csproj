<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <CoreProject Condition="'$(CoreProject)' == ''">../../src/Cehpalon.Engine.Core/Cehpalon.Engine.Core.csproj</CoreProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="CompilerFixture/**/*.cs" />
    <ProjectReference Include="$(CoreProject)" />
    <ProjectReference Include="../../src/Cehpalon.Engine.CodeGeneration/Cehpalon.Engine.CodeGeneration.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
