<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><Deterministic>true</Deterministic>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
    <EngineRoot Condition="'$(EngineRoot)' == ''">../../Cehpalon-Engine</EngineRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="[11.0.0-rc.3.26522.148]" />
    <ProjectReference Include="$(EngineRoot)/src/Cehpalon.Engine.Composition/Cehpalon.Engine.Composition.csproj" />
    <ProjectReference Include="$(EngineRoot)/src/Cehpalon.Engine.Tenancy/Cehpalon.Engine.Tenancy.csproj" />
    <ProjectReference Include="$(EngineRoot)/src/Cehpalon.Engine.Transports.GraphQL/Cehpalon.Engine.Transports.GraphQL.csproj" />
    <ProjectReference Include="$(EngineRoot)/src/Cehpalon.Engine.CodeGeneration/Cehpalon.Engine.CodeGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
